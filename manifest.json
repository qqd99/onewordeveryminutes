{
  "manifest_version": 3,
  "name": "Vocabulary SRS",
  "version": "1.13.0",
  "description": "Adaptive spaced-repetition vocabulary quizzes with a single newest review surface, meaning choices, example sentences, and adjustable speech volume.",
  "permissions": [
    "alarms",
    "storage",
    "offscreen",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vocabulary SRS — press Start",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://dict.youdao.com https://translate.google.com https://translate.googleapis.com; media-src 'self' blob: data:;"
  },
  "key": ""
}
